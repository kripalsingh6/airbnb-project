<% layout("/layout/boilerplate") -%>
<body>
  <!-- Airbnb Category Icon Filter Strip -->
  <div class="filters-wrapper">
    <div id="filters">
      <a href="/listings" class="filter-link">
        <div class="filter <%= !activeCategory && !searchQuery ? 'active' : '' %>">
          <i class="fa-solid fa-fire"></i>
          <p>Trending</p>
        </div>
      </a>
      <a href="/listings?category=Room" class="filter-link">
        <div class="filter <%= activeCategory === 'Room' ? 'active' : '' %>">
          <i class="fa-solid fa-bed"></i>
          <p>Rooms</p>
        </div>
      </a>
      <a href="/listings?category=City" class="filter-link">
        <div class="filter <%= activeCategory === 'City' ? 'active' : '' %>">
          <i class="fa-solid fa-mountain-city"></i>
          <p>Iconic cities</p>
        </div>
      </a>
      <a href="/listings?category=Mountain" class="filter-link">
        <div class="filter <%= activeCategory === 'Mountain' ? 'active' : '' %>">
          <i class="fa-solid fa-mountain"></i>
          <p>Mountains</p>
        </div>
      </a>
      <a href="/listings?category=Castle" class="filter-link">
        <div class="filter <%= activeCategory === 'Castle' ? 'active' : '' %>">
          <i class="fa-brands fa-fort-awesome"></i>
          <p>Castles</p>
        </div>
      </a>
      <a href="/listings?category=Pool" class="filter-link">
        <div class="filter <%= activeCategory === 'Pool' ? 'active' : '' %>">
          <i class="fa-solid fa-person-swimming"></i>
          <p>Amazing pools</p>
        </div>
      </a>
      <a href="/listings?category=Camp" class="filter-link">
        <div class="filter <%= activeCategory === 'Camp' ? 'active' : '' %>">
          <i class="fa-solid fa-campground"></i>
          <p>Camping</p>
        </div>
      </a>
      <a href="/listings?category=Farm" class="filter-link">
        <div class="filter <%= activeCategory === 'Farm' ? 'active' : '' %>">
          <i class="fa-solid fa-cow"></i>
          <p>Farms</p>
        </div>
      </a>
      <a href="/listings?category=Arctic" class="filter-link">
        <div class="filter <%= activeCategory === 'Arctic' ? 'active' : '' %>">
          <i class="fa-regular fa-snowflake"></i>
          <p>Arctic</p>
        </div>
      </a>
      <a href="/listings?category=Beach" class="filter-link">
        <div class="filter <%= activeCategory === 'Beach' ? 'active' : '' %>">
          <i class="fa-solid fa-umbrella-beach"></i>
          <p>Beach</p>
        </div>
      </a>
      <a href="/listings?category=Boat" class="filter-link">
        <div class="filter <%= activeCategory === 'Boat' ? 'active' : '' %>">
          <i class="fa-solid fa-sailboat"></i>
          <p>Boats</p>
        </div>
      </a>
    </div>

    <!-- Tax Toggle Switch -->
    <div class="tax-toggle">
      <div class="form-check form-switch m-0">
        <input class="form-check-input" type="checkbox" role="switch" id="taxSwitch">
        <label class="form-check-label" for="taxSwitch">Display taxes</label>
      </div>
    </div>
  </div>

  <!-- Hotel / Stay Count & City Destination Header (Airbnb UI) -->
  <div class="search-summary-card p-3 p-md-4 rounded-4 border bg-white shadow-sm mb-4 mt-2">
    <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
      <div>
        <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
          <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-3 py-1 rounded-pill fw-bold">
            <i class="fa-solid fa-hotel me-1"></i> <%= allListing.length %> hotel<%= allListing.length === 1 ? '' : 's' %> available
          </span>
          <% if(typeof searchQuery !== 'undefined' && searchQuery){ %>
            <span class="badge bg-light text-dark border px-3 py-1 rounded-pill">
              <i class="fa-solid fa-location-dot me-1 text-danger"></i> <%= searchQuery %>
            </span>
          <% } %>
          <% if(typeof checkIn !== 'undefined' && checkIn && typeof checkOut !== 'undefined' && checkOut){ %>
            <span class="badge bg-light text-dark border px-3 py-1 rounded-pill">
              <i class="fa-regular fa-calendar me-1 text-primary"></i> <%= checkIn %> &rarr; <%= checkOut %>
            </span>
          <% } %>
          <% if(typeof guests !== 'undefined' && guests){ %>
            <span class="badge bg-light text-dark border px-3 py-1 rounded-pill">
              <i class="fa-solid fa-user-group me-1 text-success"></i> <%= guests %> guest<%= guests > 1 ? 's' : '' %>
            </span>
          <% } %>
        </div>

        <h3 class="fw-bold mb-1">
          <% if(typeof searchQuery !== 'undefined' && searchQuery){ %>
            Over <%= allListing.length %> place<%= allListing.length === 1 ? '' : 's' %> in <%= searchQuery %>
          <% } else if(typeof activeCategory !== 'undefined' && activeCategory){ %>
            <%= allListing.length %> <%= activeCategory %> stay<%= allListing.length === 1 ? '' : 's' %> available
          <% } else { %>
            Over <%= allListing.length %> stays worldwide
          <% } %>
        </h3>
        <p class="text-muted small mb-0">
          Explore top-rated verified stays with guaranteed host hospitality.
        </p>
      </div>

      <% if((typeof searchQuery !== 'undefined' && searchQuery) || (typeof activeCategory !== 'undefined' && activeCategory) || (typeof checkIn !== 'undefined' && checkIn)){ %>
        <div>
          <a href="/listings" class="btn btn-outline-dark rounded-pill px-3 py-2 small fw-semibold">
            <i class="fa-solid fa-rotate-left me-1"></i> Clear filters
          </a>
        </div>
      <% } %>
    </div>
  </div>

  <!-- Empty State when No Listings Match -->
  <% if(allListing.length === 0){ %>
    <div class="text-center my-5 py-5">
      <i class="fa-solid fa-magnifying-glass text-muted mb-3" style="font-size: 3rem;"></i>
      <h4 class="fw-bold">No properties found</h4>
      <p class="text-muted">
        <% if(searchQuery){ %>
          No listings matched "<%= searchQuery %>". Try searching for another city, country, or keyword.
        <% } else { %>
          No listings available in this category yet.
        <% } %>
      </p>
      <a href="/listings" class="btn btn-brand px-4 py-2 mt-2">Explore All Listings</a>
    </div>
  <% } else { %>
    <!-- Listings Grid -->
    <%
      let stayNights = 1;
      let hasDates = false;
      if (typeof checkIn !== 'undefined' && checkIn && typeof checkOut !== 'undefined' && checkOut) {
        let d1 = new Date(checkIn);
        let d2 = new Date(checkOut);
        if (!isNaN(d1.getTime()) && !isNaN(d2.getTime()) && d2 > d1) {
          stayNights = Math.max(1, Math.round((d2 - d1) / (1000 * 60 * 60 * 24)));
          hasDates = true;
        }
      }
    %>
    <div class="row row-cols-xxl-4 row-cols-lg-3 row-cols-md-2 row-cols-1 g-4 mb-5">
      <% for(let listing of allListing){ %>
        <div class="col">
          <a href="/listings/<%= listing._id %><%= hasDates ? ('?checkIn=' + checkIn + '&checkOut=' + checkOut + '&nights=' + stayNights + '&guests=' + (typeof guests !== 'undefined' ? guests : 1)) : '' %>" class="listing-link">
            <div class="card listing-card h-100">
              <div class="card-img-wrapper">
                <img 
                  src="<%= listing.image && listing.image.url ? listing.image.url : 'https://images.unsplash.com/photo-1552733407-5d5c46c3bb3b?ixlib=rb-4.0.3&auto=format&fit=crop&w=800&q=60' %>" 
                  class="card-img-top" 
                  alt="<%= listing.title %>"
                  loading="lazy"
                >
                <% const isLiked = (typeof wishlistIds !== 'undefined' && wishlistIds.includes(listing._id.toString())); %>
                <button 
                  class="wishlist-btn <%= isLiked ? 'active' : '' %>" 
                  type="button" 
                  title="<%= isLiked ? 'Remove from wishlist' : 'Save to wishlist' %>" 
                  onclick="event.preventDefault(); toggleWishlistHeart('<%= listing._id %>', this);"
                >
                  <i class="<%= isLiked ? 'fa-solid fa-heart text-danger' : 'fa-regular fa-heart' %>"></i>
                </button>
              </div>
          
              <div class="card-body">
                <div class="card-title-row">
                  <span class="text-truncate" style="max-width: 80%;"><%= listing.title %></span>
                  <span class="fw-normal text-muted"><i class="fa-solid fa-star text-warning" style="font-size: 0.8rem;"></i> 4.8</span>
                </div>
                <div class="card-location"><%= listing.location %>, <%= listing.country %></div>
                <div class="card-price-row">
                  <% if(hasDates && stayNights > 1){ %>
                    <div>
                      <b class="text-dark fs-6">&#8377; <%= ((listing.price || 0) * stayNights).toLocaleString("en-IN") %></b>
                      <span class="text-secondary small">for <%= stayNights %> nights</span>
                    </div>
                    <div class="text-muted small" style="font-size: 0.78rem;">
                      &#8377; <%= listing.price ? listing.price.toLocaleString("en-IN") : 0 %> / night
                      <i class="tax-info">&nbsp;+18% GST</i>
                    </div>
                  <% } else { %>
                    <b>&#8377; <%= listing.price ? listing.price.toLocaleString("en-IN") : 0 %></b> / night
                    <i class="tax-info">&nbsp;+18% GST</i>
                  <% } %>
                </div>
              </div>
            </div>
          </a>
        </div>
      <% } %>
    </div>
  <% } %>

  <!-- Client-side Script for Tax Toggle -->
  <script>
    const taxSwitch = document.getElementById("taxSwitch");
    if (taxSwitch) {
      taxSwitch.addEventListener("change", () => {
        const taxInfoElements = document.getElementsByClassName("tax-info");
        for (let elem of taxInfoElements) {
          elem.style.display = taxSwitch.checked ? "inline" : "none";
        }
      });
    }
  </script>
</body>
