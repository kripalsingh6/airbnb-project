<% layout("/layout/boilerplate") -%>
<body>
  <div class="row my-5">
    <div class="col-lg-5 col-md-8 mx-auto">
      <div class="form-card">
        <h2 class="fw-bold mb-2">Welcome Back</h2>
        <p class="text-muted mb-4">Log in to manage your bookings, wishlist, and listings.</p>

        <!-- Google OAuth Button -->
        <a href="/auth/google" class="btn btn-google-auth w-100 py-2 mb-3 d-flex align-items-center justify-content-center gap-2 rounded-3 text-decoration-none">
          <svg width="20" height="20" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"/>
            <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/>
            <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z" fill="#FBBC05"/>
            <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z" fill="#EA4335"/>
          </svg>
          <span class="fw-semibold">Continue with Google</span>
        </a>

        <div class="d-flex align-items-center my-3">
          <hr class="flex-grow-1 my-0 text-muted">
          <span class="px-3 text-muted small fw-semibold">or</span>
          <hr class="flex-grow-1 my-0 text-muted">
        </div>

        <form action="/login" method="post" class="needs-validation" novalidate>
          <div class="mb-3">
            <label for="username" class="form-label">Username</label>
            <input name="username" id="username" type="text" class="form-control" placeholder="Enter username" required>
            <div class="invalid-feedback">Please enter your username.</div>
          </div>

          <div class="mb-4">
            <label for="password" class="form-label">Password</label>
            <input name="password" id="password" type="password" class="form-control" placeholder="Enter password" required>
            <div class="invalid-feedback">Please enter your password.</div>
          </div>

          <button class="btn btn-brand w-100 py-2 mb-3">Log In</button>
          
          <div class="text-center text-muted">
            Don't have an account? <a href="/signup" class="text-decoration-none fw-bold text-danger">Sign up</a>
          </div>
        </form>
      </div>
    </div>
  </div>
</body>