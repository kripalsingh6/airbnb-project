<% layout("/layout/boilerplate") -%>
<body>
  <div class="row my-5">
    <div class="col-lg-5 col-md-8 mx-auto">
      <div class="form-card">
        <h2 class="fw-bold mb-2">Welcome Back</h2>
        <p class="text-muted mb-4">Log in to manage your bookings, wishlist, and listings.</p>

        <form action="/login" method="post" class="needs-validation" novalidate>
          <div class="mb-3">
            <label for="username" class="form-label">Username</label>
            <input name="username" id="username" type="text" class="form-control" placeholder="Enter username" required>
            <div class="invalid-feedback">Please enter your username.</div>
          </div>

          <div class="mb-4">
            <label for="password" class="form-label">Password</label>
            <input name="password" id="password" type="password" class="form-control" placeholder="Enter password" required>
            <div class="invalid-feedback">Please enter your password.</div>
          </div>

          <button class="btn btn-brand w-100 py-2 mb-3">Log In</button>
          
          <div class="text-center text-muted">
            Don't have an account? <a href="/signup" class="text-decoration-none fw-bold text-danger">Sign up</a>
          </div>
        </form>
      </div>
    </div>
  </div>
</body>